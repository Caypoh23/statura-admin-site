    "prepare:dev": "node scripts/prepare-config.mjs dev",
    "prepare:prod": "node scripts/prepare-config.mjs prod",
    "build:dev": "node scripts/build-static.mjs dev",
    "build:prod": "node scripts/build-static.mjs prod",
    "check": "node --check src/app.js && node --check src/supabaseClient.js && node --check scripts/prepare-config.mjs && node --check scripts/build-static.mjs"
